# 复制为 .env 后修改，docker compose 会自动读取。全部可选，不填使用默认值。

# 面板端口（host 网络，直接占用宿主机端口）
PANEL_PORT=2017

# 首次启动时的登录密码。不填则随机生成，打印在日志里并保存到 data/initial-password.txt。
# 注意：只在第一次启动（数据目录为空）时生效；之后请在面板「设置」中修改，忘记密码用：
#   docker compose exec xray-panel /xray-panel passwd
PANEL_PASSWORD=

# 时区（通知时间、按天流量统计）
TZ=Asia/Shanghai

# 数据目录（宿主机路径）
PANEL_DATA=./data

# 允许订阅地址指向内网 IP（订阅服务在局域网时开启，填 1）
SUBSCRIPTION_ALLOW_INTERNAL=

# Xray 流量统计的本机端口，0 关闭流量统计和在线用户流量
METRICS_PORT=10085

# 镜像版本：latest（最新正式版）、具体版本号如 1.0.0，或 main（main 分支最新代码）
PANEL_IMAGE_TAG=latest
